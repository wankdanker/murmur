{
  "name": "murmur",
  "version": "0.1.0",
  "description": "Chrome extension for local, in-browser speech-to-text dictation",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "test": "vitest run test/*.test.js",
    "test:e2e": "node build.mjs && node test/e2e.mjs",
    "icons": "node scripts/make-icons.mjs",
    "package": "node build.mjs && cd dist && zip -qr ../murmur.zip ."
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@huggingface/transformers": "^4.3.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module"
}
